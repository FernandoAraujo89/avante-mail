# ─── Banco de dados ──────────────────────────────────────────────
# Connection string do PostgreSQL (local em dev, self-hosted no VPS em prod).
DATABASE_URL=

# ─── Fila de envio ───────────────────────────────────────────────
# Connection string do Redis usado pelo BullMQ (local em dev, self-hosted no
# VPS em prod). Ex.: redis://:senha@127.0.0.1:6379 ou redis://localhost:6379
# sem senha em dev local.
REDIS_URL=

# ─── Envio de e-mails ────────────────────────────────────────────
# API key do Resend (https://resend.com)
RESEND_API_KEY=
# Remetente. Sem domínio próprio, use: onboarding@resend.dev
# Com domínio verificado: Avante <noreply@avantejuntos.com.br>
RESEND_FROM_EMAIL=
# Segredo do webhook do Resend (Settings → Webhooks → Signing Secret, "whsec_...").
# Usado para validar devoluções/reclamações em /api/webhooks/resend.
# Opcional em dev; recomendado em produção.
RESEND_WEBHOOK_SECRET=

# ─── Segurança ───────────────────────────────────────────────────
# String aleatória para assinar os tokens JWT de descadastro.
# Gere uma com: openssl rand -hex 32
JWT_SECRET=

# ─── App ─────────────────────────────────────────────────────────
# URL base usada nos links de tracking e descadastro dos e-mails.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
