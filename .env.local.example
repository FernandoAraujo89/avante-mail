# ─── Banco de dados ──────────────────────────────────────────────
# Connection string do PostgreSQL (local em dev, self-hosted no VPS em prod).
DATABASE_URL=

# ─── Fila de envio ───────────────────────────────────────────────
# Connection string do Redis usado pelo BullMQ (local em dev, self-hosted no
# VPS em prod). Ex.: redis://:senha@127.0.0.1:6379 ou redis://localhost:6379
# sem senha em dev local.
REDIS_URL=

# ─── Envio de e-mails (Amazon SES via SMTP) ──────────────────────
# Região do SES. São Paulo = sa-east-1.
SES_REGION=sa-east-1
# Remetente verificado no SES.
# Ex.: Avante <news@campanhas.avantejuntos.com.br>
SES_FROM_EMAIL=
# Credenciais SMTP do SES (SES → SMTP settings → Create SMTP credentials).
# NUNCA preencha valores reais aqui — este arquivo é versionado. Use o .env.local.
SES_SMTP_USER=
SES_SMTP_PASSWORD=
# Host/porta SMTP (opcionais). Padrão: email-smtp.<SES_REGION>.amazonaws.com : 587.
SES_SMTP_HOST=
SES_SMTP_PORT=587
# Máximo de e-mails por segundo. Em sandbox o SES permite 1/s; ajuste para a
# cota aprovada da conta. Padrão: 10.
SES_MAX_SEND_RATE=10
# Preço por e-mail enviado, em US$ (relatório de custo). Padrão 0.0001
# (US$ 0,10 / 1.000, tabela padrão do SES). Use 0 se estiver no free tier.
SES_PRICE_PER_EMAIL_USD=0.0001
# ARN do tópico SNS que recebe as devoluções/reclamações do SES. Quando
# definido, o webhook /api/webhooks/ses só aceita mensagens desse tópico.
SES_SNS_TOPIC_ARN=

# ─── WhatsApp (Cloud API da Meta) ────────────────────────────────
# Pode deixar em branco enquanto o canal não estiver configurado — o app e o
# envio de e-mail funcionam normalmente sem WhatsApp. Setup: Fase 0 do plano
# em docs/plano-campanhas-whatsapp.md.
# Token permanente do System User (escopos whatsapp_business_messaging e
# whatsapp_business_management).
WHATSAPP_ACCESS_TOKEN=
# ID do número remetente (Phone number ID — não é o telefone em si).
WHATSAPP_PHONE_NUMBER_ID=
# ID da conta WhatsApp Business (WABA).
WHATSAPP_WABA_ID=
# App Secret do app Meta — valida a assinatura dos webhooks (Fase 4).
# Para testar o webhook antes da conta Meta (scripts/test-whatsapp-webhook.ts),
# basta um valor fictício aqui (ex.: test-secret) — o script assina com ele.
WHATSAPP_APP_SECRET=
# String aleatória sua para o handshake do webhook (Fase 4). Valor fictício
# serve para o teste local (ex.: test-token).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# E-mail que recebe alertas de qualidade do número (opcional; padrão:
# SES_FROM_EMAIL). Enviado via SES — best-effort.
WHATSAPP_ALERT_EMAIL=
# Versão da Graph API (opcional). Padrão: v23.0.
WHATSAPP_API_VERSION=
# Mensagens por segundo do worker de WhatsApp (Fase 3). Padrão: 10.
WHATSAPP_MAX_SEND_RATE=10
# Limite diário de conversas iniciadas do tier atual do portfólio Meta
# (250 sem verificação da empresa; depois 1.000 → 10.000 → 100.000).
# Usado só para o aviso de estouro no wizard de campanhas.
WHATSAPP_DAILY_LIMIT=250

# ─── Custos / câmbio ─────────────────────────────────────────────
# Câmbio US$→R$ usado só para EXIBIR o custo das campanhas em reais (a AWS e a
# Meta cobram em US$). Aproximação — ajuste conforme o câmbio. Padrão: 5.40.
USD_BRL_RATE=5.40

# ─── Segurança ───────────────────────────────────────────────────
# String aleatória para assinar os tokens JWT de descadastro.
# Gere uma com: openssl rand -hex 32
JWT_SECRET=

# Chave do token de RASTREIO DO SITE (fase E). Opcional: sem ela, a chave é
# derivada do JWT_SECRET por HKDF, o que já garante que um token de rastreio
# nunca vale como token de sessão. Definir aqui desacopla a rotação — girar só
# o rastreio devolve os visitantes ao anonimato até o próximo clique, enquanto
# girar o JWT_SECRET deslogaria todo mundo e invalidaria um ano de links de
# descadastro já enviados.
TRACK_SECRET=

# ─── Webhook de saída (fase F) ───────────────────────────────────
# Domínios que o passo "Webhook" das automações pode chamar, separados por
# vírgula. Aceita subdomínios (make.com libera hook.eu1.make.com).
# VAZIA = nenhum webhook sai. É a defesa principal contra SSRF: sem ela, uma
# URL digitada na tela faria o servidor chamar a rede interna do Docker
# (Postgres, Redis) ou o serviço de metadados da nuvem.
# Ex.: make.com,hooks.zapier.com,n8n.avantejuntos.com.br
WEBHOOK_SAIDA_HOSTS=

# Chave da assinatura enviada em X-Avante-Assinatura, para o destino conferir
# que a chamada é nossa. Opcional: sem ela, é derivada do JWT_SECRET.
WEBHOOK_SAIDA_SECRET=

# ─── Rastreio do site (fase E) ───────────────────────────────────
# Origens EXATAS do site que pode ser rastreado, separadas por vírgula.
# Esta lista governa DUAS coisas: para onde o token pode ser anexado nos links
# do e-mail, e quem pode chamar POST /api/track/site (CORS).
# VAZIA = rastreio inerte. Ninguém liga rastreamento de pessoa por descuido.
# Ex.: https://avantejuntos.com.br,https://www.avantejuntos.com.br
SITE_TRACK_ORIGINS=

# ─── App ─────────────────────────────────────────────────────────
# URL base usada nos links de tracking e descadastro dos e-mails.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
