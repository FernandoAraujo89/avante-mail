# ─── Banco de dados ──────────────────────────────────────────────
# Connection string do PostgreSQL (local em dev, self-hosted no VPS em prod).
DATABASE_URL=

# ─── Fila de envio ───────────────────────────────────────────────
# Connection string do Redis usado pelo BullMQ (local em dev, self-hosted no
# VPS em prod). Ex.: redis://:senha@127.0.0.1:6379 ou redis://localhost:6379
# sem senha em dev local.
REDIS_URL=

# ─── Envio de e-mails (Amazon SES) ───────────────────────────────
# Região do SES. São Paulo = sa-east-1.
SES_REGION=sa-east-1
# Remetente verificado no SES.
# Ex.: Avante <news@campanhas.avantejuntos.com.br>
SES_FROM_EMAIL=
# Credenciais IAM com permissão ses:SendEmail (lidas pela cadeia padrão do
# SDK). Em produção, prefira uma IAM role; em dev, use uma chave de acesso.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Máximo de e-mails por segundo. Em sandbox o SES permite 1/s; ajuste para a
# cota aprovada da conta. Padrão: 10.
SES_MAX_SEND_RATE=10
# ARN do tópico SNS que recebe as devoluções/reclamações do SES. Quando
# definido, o webhook /api/webhooks/ses só aceita mensagens desse tópico.
SES_SNS_TOPIC_ARN=

# ─── Segurança ───────────────────────────────────────────────────
# String aleatória para assinar os tokens JWT de descadastro.
# Gere uma com: openssl rand -hex 32
JWT_SECRET=

# ─── App ─────────────────────────────────────────────────────────
# URL base usada nos links de tracking e descadastro dos e-mails.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
