<mjml>
  <mj-head>
    <mj-title>{{titulo}}</mj-title>
    <mj-preview>{{subtitulo}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text color="#D4D4D4" font-size="15px" line-height="1.7" />
      <mj-section background-color="#0D0D0D" />
    </mj-attributes>
    <mj-style>
      a { color: #F5A623; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#0D0D0D" width="600px">
    <mj-section padding="32px 24px 12px 24px">
      <mj-column>
        <mj-text align="left" font-size="20px" font-weight="700" color="#F5A623" padding="0">
          &#9650; Avante
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column>
        <mj-divider border-width="1px" border-color="#262626" padding="8px 0 0 0" />
      </mj-column>
    </mj-section>

    <mj-section padding="28px 24px 8px 24px">
      <mj-column>
        <mj-text padding="0 0 12px 0" color="#A3A3A3">
          Olá, {{nome_parceiro}}!
        </mj-text>
        <mj-text font-size="26px" font-weight="700" color="#FFFFFF" line-height="1.3" padding="0 0 10px 0">
          {{titulo}}
        </mj-text>
        <mj-text font-size="16px" color="#A3A3A3" padding="0 0 20px 0">
          {{subtitulo}}
        </mj-text>
        <mj-text padding="0 0 28px 0">
          {{corpo}}
        </mj-text>
        <mj-button background-color="#F5A623" color="#000000" font-weight="700" font-size="15px" inner-padding="14px 32px" border-radius="8px" align="left" padding="0 0 12px 0" href="{{cta_url}}">
          {{cta_texto}}
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="32px 24px 40px 24px">
      <mj-column>
        <mj-divider border-width="1px" border-color="#262626" padding="0 0 20px 0" />
        <mj-text font-size="12px" color="#737373" padding="0 0 6px 0">
          Avante Soluções Digitais · Formiga, MG
        </mj-text>
        <mj-text font-size="12px" color="#737373" padding="0">
          Não quer mais receber nossos e-mails?
          <a href="{{unsubscribe_url}}" style="color:#F5A623;">Descadastre-se aqui</a>.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
